# Neon Postgres (Vercel > Storage > Neon cria esta variável automaticamente)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Qualquer string aleatória com 32+ caracteres
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional: OSRM próprio (padrão: servidor demo público)
# OSRM_URL=https://router.project-osrm.org
